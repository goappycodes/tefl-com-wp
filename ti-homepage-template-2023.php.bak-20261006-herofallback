/**
 * Geo-homepage shared sections (added 2026-10-06).
 * Returns THIS page's value for a shared section, or falls back to the main
 * .com homepage (page_on_front) when a geo page leaves that section empty.
 * The main homepage is unaffected: its shared fields are always populated,
 * so is_array_empty() is false and no fallback path is taken.
 */
if (!function_exists('ti_hp_shared_field')) {
    function ti_hp_shared_field($selector) {
        $val = get_field($selector);
        if (is_array_empty($val)) {
            $main_id = (int) get_option('page_on_front');
            if ($main_id && $main_id !== get_queried_object_id()) {
                $val = get_field($selector, $main_id);
            }
        }
        return $val;
    }
}

